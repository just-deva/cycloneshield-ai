# Copy to .env (never commit .env). Every key is optional: without it the feature runs in a labelled degraded mode.

# Gemini API key from https://aistudio.google.com/apikey . Use a key on a project with billing enabled (paid tier)
# for the deployed demo: free-tier prompts are used by Google to improve products and grounding is unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# Google Cloud project registered for Earth Engine (used with Application Default Credentials).
GOOGLE_CLOUD_PROJECT=
EE_ENABLED=auto

# Telegram bot for REAL advisory delivery + Acknowledge button (create with @BotFather; get chat id from @userinfobot or getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=change-me
# Local development: poll for button presses instead of using a public webhook
TELEGRAM_POLLING=false

# Optional: where dispatch POSTs the CAP file (defaults to this service's own /api/mock-deoc demo receiver)
DISPATCH_WEBHOOK_URL=
PUBLIC_BASE_URL=
